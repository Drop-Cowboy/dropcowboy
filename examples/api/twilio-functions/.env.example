# Copy to .env and fill in. The Twilio CLI deploys these as the Service's
# environment variables. .env is git-ignored. Never commit it.
#
# The Twilio CLI also writes ACCOUNT_SID and AUTH_TOKEN here for you when you
# deploy. Leave those two alone.

# Your Detection key (Developers > Detection keys in the dashboard).
DC_DETECTION_KEY=

# A long random secret shared by both Functions. Make one with: openssl rand -hex 32
# It is part of the webhook address Detection posts to, so treat it like a password.
DC_DETECTION_WEBHOOK_TOKEN=

# What plays when the beep is heard. Set one. Audio wins when both are set.
# Audio: a public https:// address of an .mp3 or .wav file.
# Text: Twilio speaks it, up to 1000 characters.
DC_VM_AUDIO_URL=
DC_VM_TEXT=
