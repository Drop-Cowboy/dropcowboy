# Copy this file to .env and fill in your values. The examples load .env when
# it exists in the directory you run them from. Never commit the real file.
#
# Send only to people who agreed to hear from you. Test with numbers you own.

# Required: your API key pair (Developers > API keys in the dashboard).
DC_KEY=
DC_SECRET=

# Required for sends: the recipient, in E.164. Use a number you own.
DC_TO=+13125550142

# Optional: public HTTPS base URL of your tunnel (see the README). Without it
# the recipes send without a callback_url and do not wait for a result.
# DC_PUBLIC_URL=https://example.ngrok.app

# Optional: receiver port (default 3000) and how long a recipe waits for a
# result in seconds (default 300, 0 = send and exit).
# PORT=3000
# DC_WAIT_SECONDS=300

# Optional: signing secret(s), comma separated. When unset the receiver loads
# them from the API at start-up. check_receiver.py signs its sample webhook
# with the first one.
# DC_WEBHOOK_SECRET=

# Audio, used in this order: DC_MEDIA_ID, then DC_AUDIO_FILE, then DC_TTS_BODY
# (with DC_VOICE_ID), then DC_AUDIO_URL. On retail, with none set, the first
# file in your media library is used.
# DC_MEDIA_ID=
# A .mp3 or .wav on this computer (uploaded first), or an https:// address of
# one (imported). upload_media.py uploads it on its own and prints the media_id.
# DC_AUDIO_FILE=./appointment-reminder.mp3
# DC_MEDIA_NAME=Appointment reminder
# audio_url is an option for BYOC plans only and must be enabled by support.
# Contact support to enable it. If you're testing on a retail account before
# connecting your carrier, support can enable it for testing, and you can then
# send only to your test numbers. Otherwise, upload the file and send media_id,
# or use text to speech.
# DC_AUDIO_URL=https://audio.example.com/voicemails/appointment-reminder.mp3

# Retail recipe: the phone line. Falls back to your default line.
# DC_PHONE_LINE_ID=

# BYOC recipe: a number you are entitled to use. Retail never sends it.
# DC_CALLER_ID=+13125550177
# DC_STI_ORIG_ID=
# STIR/SHAKEN. The level your carrier assigned to the number: A, B or C. Never send a higher level than your carrier gave you.
# DC_STI_ATTESTATION=B

# Local presence recipe.
# DC_LINE_NAME=Local presence
# DC_NUMBERS=+13125550143,+14155550144
# DC_AREA_CODES=312,415
# DC_RENT=no

# Text to speech recipe.
# DC_TTS_BODY=Hi, this is Example Dental with a reminder about your appointment tomorrow.
# DC_VOICE_ID=
# DC_MODE=retail
# DC_PREVIEW=no
