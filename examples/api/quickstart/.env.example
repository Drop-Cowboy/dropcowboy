# Send only to people who agreed to hear from you. Test with numbers you own.
#
# Copy this file to .env and fill it in. .env stays on your computer: never
# commit it. Variables already set in your shell win over this file.
# One setting per line; a # starts a comment only at the start of a line.

# Your API key pair. Create it under Developers > API keys in the dashboard.
DC_KEY=
DC_SECRET=

# The recipient, in E.164 format. Use a number you own, added as a test number
# on the Dialing rules page.
DC_TO=+1XXX555XXXX

# Optional. The phone line to send from. Leave it empty to use your default line.
DC_PHONE_LINE_ID=

# Where the audio comes from: upload (default), media, url or tts.
DC_AUDIO=upload

# DC_AUDIO=upload: path to an .mp3 or .wav file. The quickstart uploads it and
# prints the media_id so you can reuse it with DC_AUDIO=media.
DC_AUDIO_FILE=./greeting.mp3
# Optional display name for the uploaded file.
DC_MEDIA_NAME=

# DC_AUDIO=media: a file already in your media library.
DC_MEDIA_ID=

# DC_AUDIO=url: a public http(s) URL of an MP3 or WAV file. audio_url is an
# option for BYOC plans only and must be enabled by support.
DC_AUDIO_URL=

# DC_AUDIO=tts: the text to speak (1,200 characters or fewer), and a voice.
# Leave DC_VOICE_ID empty to use your first ready voice.
DC_TTS_BODY=
DC_VOICE_ID=

# Optional. The public https:// address of your tunnel, with no path. Without
# it the send has no callback_url and the quickstart does not wait.
DC_PUBLIC_URL=

# Optional. The receiver's port (default 3000) and address (default 127.0.0.1).
PORT=3000
DC_LISTEN_HOST=

# Optional. Webhook signing secret(s), comma separated. When empty, the
# quickstart reads them from the API. check-receiver needs it to sign its test.
DC_WEBHOOK_SECRET=

# Optional. Seconds to wait for the result. Default 300. 0 sends and exits.
DC_WAIT_SECONDS=300

# Optional. true: create a webhook for this run (status and receipt events,
# pointing at DC_PUBLIC_URL), verify and print every delivery, then delete the
# webhook when the run ends. Needs DC_PUBLIC_URL and DC_WAIT_SECONDS above 0.
DC_MANAGE_WEBHOOK=

# Optional. With DC_MANAGE_WEBHOOK, seconds to wait after the first result for
# the status and receipt webhooks. Default 120. 0 does not wait.
DC_RECEIPT_WAIT_SECONDS=

# Optional. true: print the headers and JSON body of every delivery.
# DC_MANAGE_WEBHOOK turns this on.
DC_SHOW_PAYLOADS=
