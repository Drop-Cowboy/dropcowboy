# Copy this file to .env.local or export these in your shell. The app reads the
# environment only: it does not load files. Never commit a file that holds your secret.
#
# bash/zsh:       set -a; source .env.local; set +a
# PowerShell:     $env:DC_KEY = "..."

# Required for every command except "receiver"
DC_KEY=
DC_SECRET=

# The recipient, in E.164 format (+, country code, number). Use a number you own.
DC_TO=+13125550142

# Public HTTPS address of this receiver, from a tunnel. Without it a send still goes
# out, but its result will not arrive here. No trailing path.
# DC_PUBLIC_URL=https://abc123.example.com
# PORT=3000

# Webhook signing secrets, comma separated. When unset the receiver loads them from the API.
# check-receiver signs its sample webhook with the first one.
# DC_WEBHOOK_SECRET=

# How long a recipe waits for the result. 0 means send and exit.
# DC_WAIT_SECONDS=300

# Audio. Set one. Order of use: DC_MEDIA_ID, DC_AUDIO_FILE, DC_TTS_BODY, DC_AUDIO_URL.
# DC_MEDIA_ID=
# A .mp3 or .wav on this computer (uploaded first), or an https:// address of one
# (imported). "dotnet run -- upload-media" uploads it on its own and prints the media_id.
# DC_AUDIO_FILE=./appointment-reminder.mp3
# DC_MEDIA_NAME=Appointment reminder
# DC_TTS_BODY=Hi, this is Example Dental with a reminder about your appointment tomorrow.
# audio_url is an option for BYOC plans only and must be enabled by support. Contact
# support to enable it. If you're testing on a retail account before connecting your
# carrier, support can enable it for testing, and you can then send only to your test
# numbers. Otherwise, upload the file and send media_id, or use text to speech.
# DC_AUDIO_URL=

# Retail: the phone line to send from. Default: your account's default line.
# DC_PHONE_LINE_ID=

# Bring your own carrier
# Must be a number you are entitled to use. Always identify your business location truthfully when asked by recipients.
# DC_CALLER_ID=+13125550177
# DC_STI_ORIG_ID=
# The level your carrier assigned to the number: A, B or C. Never send a higher level than your carrier gave you.
# DC_STI_ATTESTATION=B

# Text to speech
# DC_VOICE_ID=
# DC_MODE=retail
# DC_PREVIEW=no

# Local presence
# DC_LINE_NAME=Local presence
# DC_NUMBERS=+13125550142,+14155550101
# DC_AREA_CODES=312,415
# Renting charges your carrier. Only the exact lowercase word yes rents; anything else is a dry run.
# DC_PREVIEW works the same way: only yes.
# DC_RENT=no

# Point the examples at another server (the tests do this)
# DC_BASE_URL=https://api-v2.dropcowboy.com
