# Send only to people who agreed to hear from you. Test with numbers you own.
#
# Copy this file to .env and fill it in. .env is ignored by git.
# Lines starting with # are comments. Leave a variable empty (or delete the
# line) when you do not need it.

# --- Required for every recipe --------------------------------------------
# Create a key under Developers > API keys in the dashboard.
DC_KEY=
DC_SECRET=

# The person to send to, in E.164 format. Use a number you own.
DC_TO=+13125550142

# --- Result delivery -------------------------------------------------------
# The public HTTPS address of a tunnel that reaches this receiver, with no
# trailing path. Without it a send has no callback_url and results will not
# arrive here. Example: https://abc123.example.com
DC_PUBLIC_URL=

# Port the receiver listens on. Default 3000. Use 0 to let the system choose.
PORT=3000

# How long a recipe waits for the result, in seconds. Default 300.
# 0 means send and exit without waiting.
DC_WAIT_SECONDS=300

# Webhook signing secret(s), comma separated. Leave empty and the receiver
# loads them from your account when it starts. check-receiver signs its sample
# webhook with the first one.
DC_WEBHOOK_SECRET=

# --- Audio: set ONE of these. Order of use: media, file, text to speech, URL.
# An audio file already uploaded to your account (GET /media/public/media).
DC_MEDIA_ID=
# A .mp3 or .wav on this computer (uploaded first), or an https:// address of
# one (imported). npm run upload-media uploads it on its own and prints the
# media_id. DC_MEDIA_NAME names it in your media library (default: file name).
DC_AUDIO_FILE=
DC_MEDIA_NAME=
# Text to speak, 1,200 characters or fewer. Needs a voice (see DC_VOICE_ID). Name the sender, for example:
# Hi, this is Example Dental with a reminder about your appointment tomorrow.
DC_TTS_BODY=
# A public mp3 or wav URL. audio_url is an option for BYOC plans only and must
# be enabled by support. Contact support to enable it. If you're testing on a
# retail account before connecting your carrier, support can enable it for
# testing, and you can then send only to your test numbers. Otherwise, upload
# the file and send media_id, or use text to speech.
DC_AUDIO_URL=

# --- Phone line and voice (retail accounts) -------------------------------
# The phone line to send from. Leave empty to use your default phone line.
DC_PHONE_LINE_ID=
# The voice for text to speech. Leave empty to use your first ready voice.
DC_VOICE_ID=

# --- send:byoc and send:local-presence -------------------------------------
# A number you are entitled to use, in E.164 format, such as your own number at your carrier
# (send:byoc, or send:tts with DC_MODE=byoc). Always identify your business location truthfully when asked by recipients.
DC_CALLER_ID=
# Optional STIR/SHAKEN details. Set both or neither.
# DC_STI_ORIG_ID is a UUID. DC_STI_ATTESTATION (for example B): The level your carrier assigned to the number: A, B or C. Never send a higher level than your carrier gave you.
DC_STI_ORIG_ID=
DC_STI_ATTESTATION=

# --- send:local-presence ---------------------------------------------------
# Name of the phone line to reuse or create. Default: Local presence
DC_LINE_NAME=
# Numbers you already own, comma separated, to load onto the line.
DC_NUMBERS=
# Area codes to search for more numbers, comma separated, for example 312,415.
DC_AREA_CODES=
# Set to yes to rent the numbers found for DC_AREA_CODES. Renting charges your
# carrier. Anything else is a dry run that rents nothing.
DC_RENT=

# --- send:tts --------------------------------------------------------------
# retail (default) sends from a phone line. byoc sends from DC_CALLER_ID.
DC_MODE=retail
# yes synthesizes the text first so you can listen. Billed per character.
DC_PREVIEW=

# --- Advanced --------------------------------------------------------------
# Only change this to point at a mock server.
DC_BASE_URL=https://api-v2.dropcowboy.com
